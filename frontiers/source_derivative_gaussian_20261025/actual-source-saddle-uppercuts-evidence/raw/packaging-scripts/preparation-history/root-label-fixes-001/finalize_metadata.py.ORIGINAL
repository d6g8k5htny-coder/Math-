#!/usr/bin/env python3
"""Prepared65 metadata worker. Execute only after explicit final root GO."""
from pathlib import Path
import copy,json,tomllib
import custody as f
import archive_prepare as archive
R,P,U,B,A,E=f.R,f.P,f.U,f.B,f.A,f.E
REL=Path('frontiers/source_derivative_gaussian_20261025');O=R/'overlay'/REL
M='SourceActualSaddleUppercuts'
TARGET='I4SourceActualSaddleUppercuts.actualSource_quotient_saddle_uniform_closed_uppercuts'
CNAME='ACTUAL_SADDLE_UPPERCUTS_EVIDENCE_CATALOG.json'
META=['README.md','SCOPE.md','lakefile.toml','SOURCE_MANIFEST.json','SOURCE_SHA256SUMS']
BASE_MANIFEST='ad4b8983b5a555c6fdc0c4a33d1f42795746c145f57f0453927efac6598af415'
BASE_SUMS='de065404590743f927477b252afd789a848ee14bd9f15de631d8f79fcc6d1469'
SCOPE='Coherent actual saddle lower and uniform positive CLOSED uppercuts. Positive original period/sample, actual criticality and FULL complementary Hessian inertia1, NO global hm: for EVERY prescribed open O invoke accepted public64 exactly once internally, retain the SAME rho/phi/source/exact Pi ball/ordered field identity, project ALL delta>=0 lower traces unchanged, and derive epsilon0=rho^2/4>0 with TWO NONEMPTY path-connected/disjoint sign branches, union and JoinedIn iff positive coordinate1 product for ALL0<epsilon<epsilon0. No per-cut chart choice/certificate/norm-isometry/global merger or public data.'
def text(path,value):f.durable(path,value.encode());return f.identity(path)
def check(name,fn):
    journal=R/'VALIDATION_PROGRESS.jsonl'
    prior=[x for x in map(json.loads,journal.read_text().splitlines()) if x['event']=='check_passed' and x['name']==name] if journal.exists() else []
    if prior:return prior[-1]['detail']
    f.append('VALIDATION_PROGRESS.jsonl',{'event':'check_started','name':name})
    try:detail=fn()
    except BaseException as exc:
        f.append('VALIDATION_PROGRESS.jsonl',{'event':'check_failed','name':name,'exception':repr(exc)});raise
    f.append('VALIDATION_PROGRESS.jsonl',{'event':'check_passed','name':name,'detail':detail});print('PASS '+name,flush=True)
def assemble():
    f.require(not (R/'ASSEMBLY_RESULT.json').exists(),'Completed65 metadata is reusable; never restart')
    c=f.read(R/'FINAL_INPUTS.json');archive.gate(c);raw=archive.prepare(c);cut=c['source_cut']
    bm=f.read(B/'SOURCE_MANIFEST.json');snap=R/'published64-metadata'
    for name in META:
        h=BASE_MANIFEST if name=='SOURCE_MANIFEST.json' else BASE_SUMS if name=='SOURCE_SHA256SUMS' else bm['files'][name]
        f.copied(B/name,snap/name,{'bytes':(B/name).stat().st_size,'sha256':h})
    oldkeys=list(bm['files']);oldrows=[line.split('  ',1)[1] for line in (snap/'SOURCE_SHA256SUMS').read_text().splitlines()]
    f.write(R/'BASELINE_BINDING.json',{'publication':f.BASE,'manifest_identity_reused':BASE_MANIFEST,'sums_identity_reused':BASE_SUMS,'manifest_key_sequence':oldkeys,'independent_checksum_row_sequence':oldrows,'old_hashes':0})
    records={}
    for path,rec in list(f.identities().items()):
        src=Path(path)
        if A not in src.parents:continue
        rel=src.relative_to(A);dst=O/(rel.name if rel.parts[0]=='bindings' else rel)
        records[str(dst.relative_to(O))]=f.copied(src,dst,rec)
    inv=c['inventory_summary'];owned=inv['all_module_index_owned_constants'];reading=f.read(Path(c['root_reading_record']))
    publication={'status':'QUALIFIED65_SCRATCH_PROPOSAL_ROOT_APPLY_ONLY','source_cut':cut,'source_cut_parent':c['source_cut_parent'],'qualified_baseline64':f.BASE,'root_reading_verbatim':reading,'root_reading_summary':c['root_reading_summary'],'reviewer_reading_summary':c['reviewer_reading_summary'],'packager_is_65_proof_author':False,'packager_proof_role':'65 metadata preparation only; prior62A authorship does not transfer to64','packager_independent_review_credit':0,'no_inherited64_review_credit':True,'historical_pending_records_preserved':True,'remote62publication_claimed':False,'hosted62CI_claimed':False,'scientific_effect':'NONE','same_family_credit':0}
    catalog={'module':M,'namespace':'I4SourceActualSaddleUppercuts','public_Prop_targets':[TARGET],'public_data':0,'scope':SCOPE,'source_cut':cut,'source_identity':c['source_identity'],'eligible_object_identity':c['eligible_object_identity'],'object_action':'SKIP_ROOT_COPIED_ONCE','actual_owned_constants':owned,'inventory_summary':inv,'ordinary_inventory_summary':c['ordinary_inventory_summary'],'full_inventory_archive_path':c['inventory_archive_path'],'qualification_records':c['qualification'],'sole_negative':c['negative_binding'],'production_helper_integrations':raw['production_helpers'],'ordinary_controls_custody':raw['ordinary_controls_custody'],'kernel_coverage':'Complete production including ONE private finite-Pi2 geometry TEXT section, producer joins and actual both-saddle/small-O/seam/equality positives. Producer ordinary Controls/inverse-zero-cut counterproof/soleFalse and ordinary exhaustive inventory have separate qualification; production kernel covers no ordinary Controls.','actual_run_count':raw['actual_run_count'],'verification_run_count':raw['verification_run_count'],'documentary_run_count':raw['documentary_run_count'],'unlabeled_run_count':raw['unlabeled_run_count'],'documentary_capture_records':raw['documentary_capture_records'],'actual_split_stream_files':raw['actual_split_stream_files'],'actual_split_stream_bytes':raw['actual_split_stream_bytes'],'record_schema':'ACTUAL65 receipt.json/scope_kind math-or-documentary/command_argv/start_utc/end_utc/before/after/before_snapshots{canonical:immutable_path}/streams{stdout.log,stderr.log}; retain actual runner001/002 histories and first-ID cache. Mathematical and documentary counts stay distinct; all actual runner/context versions and important documentary OUTER captures retained. Timeout124/resource failures are never intended mathematical False.','all_attempts_preserved':True,'raw_catalog':'RAW_EVIDENCE_CATALOG.json','publication':publication,'verification_reuse':'All applicable completed source/math/identity/strict/inventory/ONEkernel/Controls/soleFalse evidence reused. Only new metadata associations checked.','canonical_authority':f.AUTHORITY,'link_delivery_not_reading':True,'scientific_effect':'NONE','same_family_credit':0}
    for name,value in [('RAW_EVIDENCE_CATALOG.json',raw),('PUBLICATION_CONTEXT.json',publication),(CNAME,catalog)]:records[E+'/'+name]=f.write(O/E/name,value)
    for name in c['curated_producer_files']:records[E+'/'+name]=f.copied(O/E/'raw/producer'/name,O/E/name,records[E+'/raw/producer/'+name])
    rp=c['review_report_archive_path'];records[E+'/AUTHOR_SIDE_REVIEW.md']=f.copied(O/E/rp,O/E/'AUTHOR_SIDE_REVIEW.md',records[E+'/'+rp])
    cp={'status':'SKIP_ALL_OWN_OLD_CONTROLS_HELPER_OBJECT_COPIES','root_copy_record':c['root_object_copy_record'],'eligible_own_object_identity':c['eligible_object_identity'],'copies':[],'further_copy_actions':[],'ordinary_control_objects_ineligible':True,'helper_inventory_old_objects_ineligible':True,'ilean_refreshes':0}
    records[E+'/COPY_PLAN.json']=f.write(O/E/'COPY_PLAN.json',cp);f.write(R/'COPY_PLAN.json',cp)
    body=f"""[{M}.lean]({M}.lean) appends exactly one actual saddle uniform closed-uppercut proposition and no public data. Positive original period/sample, actual criticality and FULL complementary inertia1 are the local premises; no global hm or desired chart/certificate is supplied. For EVERY prescribed open O, accepted PUBLIC64 is called exactly once internally. ONE unchanged rho/phi/source/exact Point2 Pi-norm target ball/ordered actual identity is retained; ALL delta>=0 lower closed traces are projected unchanged. With epsilon0=rho^2/4>0, the SAME chart serves ALL0<epsilon<epsilon0 CLOSED uppercuts, both NONEMPTY path-connected sign branches, disjoint union and exact JoinedIn equivalence by positive coordinate1 product. No shrink/reselection/per-sign/per-cut chart, norm-isometry or strict-cut replacement is asserted.

SAME normalized original period2 cos(pi*x)+2*cos(pi*y), BOTH genuine saddles, seam lift and prescribed small ambient O exercise actual local criticality/FULL inertia. Equality-at-cutoff inverse points at +/-rho/4 give actual F=c+rho^2/16 and CLOSED membership. At most ONE production private finite-Pi2 geometry TEXT original freezes before ONE integration with ZERO helper executions/hashes/objects; producer owns transport/publicassembly/actual fixtures/ordinary Controls and all amendments. No ordinary TEXT helper exists. Production kernel excludes ordinary Controls; both production and ordinary mathematical constants require separate exhaustive actual inventories/std3 qualification.

The sole mutation weakens epsilon>0 to epsilon>=0 with SAME upper bound/chart/radius/source/field/carrier/CLOSED cut. At epsilon=0, the independent ordinary full inverse vertical segment between +/-rho/2 stays in the target/source/zero-cut, has relative continuity/exact inverse endpoints and actual midpoint q. This refutes the mutant JoinedIn sign-product claim without using the production upper branches or inherited lower-PC shortcut. Passed independent counterproof precedes ONE importing False; no second mutation or changed chart/sample/level/strictness.

Qualified64 `{f.BASE}` appends to65 modules/1135 written=1126Prop+9data/32 inputs. Actual owned production count {owned}, separately inventoried ordinary constants and all {raw['actual_run_count']} producer workers/{raw['actual_split_stream_files']} worker streams/{raw['actual_split_stream_bytes']}B remain archived. Mathematical calls {raw['verification_run_count']}, documentary calls {raw['documentary_run_count']}, unlabeled calls {raw['unlabeled_run_count']} are distinct. ALL original source/harness/runner/context versions/snapshots/ACKs/freezes/FULL patches/failures/commands/cwd/times/exits/streams and actual outer/entry captures retain their scope; actual final counts/schemas govern, no stage64 guesses. Five installed bindings and ALL objects SKIP after root's sole eligible new own copy. Existing IDs reused; first-new IDs cached once; no old hash/math/object campaign.

Root reading: {c['root_reading_summary']}. Nonauthor technical review: {c['reviewer_reading_summary']}. Packager65 proof-author FALSE, independentcredit0; prior62A exposure does not transfer authorship. Root alone handles sourcecut/local/native commit bindings, metadata application/Git/cache/external publication. No CLI authentication retry/change or native write is a packager action. Existing64 hosted results are not65 CI. Proper66 root EXTRA docs are excluded65archive/manifest/registry; no future seat. ScientificNONE/same-family0, completed applicable verification reusable/provider process separate. Global collars/adjacency/critical events/elder/count/Borel/Rice/PairLaw/Parent remain OPEN.
"""
    for name,title in [('README.md','# Actual saddle uniform closed uppercuts'),('SCOPE.md','# Proposed65 modules/1135 written/32 inputs')]:records[name]=text(O/name,title+'\n\n'+body+'\n---\n\n# Historical qualified64 context preserved verbatim\n\n'+(snap/name).read_text())
    lake=(snap/'lakefile.toml').read_text();marker='"SourceActualQuotientSaddleCollar"]';f.require(lake.count(marker)==1,'Unique inherited64 last target')
    lake=lake.replace(marker,'"SourceActualQuotientSaddleCollar", "'+M+'"]')+'\n[[lean_lib]]\nname = "'+M+'"\n';records['lakefile.toml']=text(O/'lakefile.toml',lake)
    manifest=copy.deepcopy(bm);manifest['source_modules'].append(M+'.lean');manifest['targets'].append(TARGET)
    manifest['qualification_role']='Root proposal65/1135written=1126Prop+9data/32 against qualified64 '+f.BASE
    manifest['verification_reuse']='Completed applicable proof/object/identity checks reusable; no old replay for sourcecut/session/provider/process. Actual root/reviewer reading scopes retained separately.'
    manifest['catalogs'].append({'path':E+'/'+CNAME,'source_cut':cut,'scope':SCOPE,'sha256':records[E+'/'+CNAME]['sha256']})
    manifest['new_actual_saddle_uppercuts_scope']={'module':M,'source_cut':cut,'public_propositions':[TARGET],'public_data':0,'actual_owned_constants':owned,'inventory_summary':inv,'ordinary_inventory_summary':c['ordinary_inventory_summary'],'catalog':E+'/'+CNAME,'scope':SCOPE,'publication':publication}
    for name in ['README.md','SCOPE.md','lakefile.toml']:manifest['files'][name]=records[name]['sha256']
    newpaths=sorted(p for p in records if p not in bm['files'])
    for path in newpaths:manifest['files'][path]=records[path]['sha256']
    mid=f.write(O/'SOURCE_MANIFEST.json',manifest);sid=text(O/'SOURCE_SHA256SUMS',''.join(manifest['files'][p]+'  '+p+'\n' for p in oldrows+newpaths))
    bs={x['path'] for x in raw['bindings']};allrecords={**records,'SOURCE_MANIFEST.json':mid,'SOURCE_SHA256SUMS':sid}
    plan={'status':'ROOT_ONLY_EXACT64_APPLY_AFTER_METADATA_PASS','expected_HEAD':cut,'qualified_baseline':f.BASE,'overlay_root':str(R/'overlay'),'destination_root':'/workspace/Math-curvature-20261026','apply':[],'skip':[],'cache_object_actions':[]}
    for path,value in sorted(allrecords.items()):plan['skip' if path in bs else 'apply'].append({'path':str(REL/path),'bytes':value['bytes'],'sha256':value['sha256']})
    pid=f.write(R/'APPLY_PLAN.json',plan)
    def registry():
        f.require(manifest['source_modules']==bm['source_modules']+[M+'.lean'] and manifest['targets']==bm['targets']+[TARGET],'One64 module/Prop append')
        f.require((len(manifest['source_modules']),len(manifest['targets']),manifest['inherited_input_count'])==(65,1135,32),'65/1135/32')
        return '1126Prop+9data/32; no public data'
    check('exact65_registration',registry)
    def prefixes():
        f.require(len(oldkeys)==7331 and list(manifest['files'])[:7331]==oldkeys,'7331 inherited manifest KEY prefix')
        f.require({p for p in oldkeys if bm['files'][p]!=manifest['files'][p]}=={'README.md','SCOPE.md','lakefile.toml'},'Only three inherited digest changes')
        rows=[line.split('  ',1) for line in (O/'SOURCE_SHA256SUMS').read_text().splitlines()]
        f.require([p for h,p in rows[:len(oldrows)]]==oldrows,'Independent checksum ROW prefix')
        f.require([p for h,p in rows[len(oldrows):]]==newpaths and {p:h for h,p in rows}==manifest['files'],'Append-only checksum association')
        f.require(not {'SOURCE_MANIFEST.json','SOURCE_SHA256SUMS'}&set(manifest['files']),'No self entries')
        return 'Separate inherited7331 key and independent row order; zero old hashes'
    check('separate_manifest_key_and_checksum_row_prefixes',prefixes)
    def lakecheck():
        old=tomllib.loads((snap/'lakefile.toml').read_text());new=tomllib.loads(lake)
        f.require(new['defaultTargets']==old['defaultTargets']+[M] and new['lean_lib']==old['lean_lib']+[{'name':M}],'One library/default target append')
        f.require(all(new[k]==old[k] for k in old if k not in ['defaultTargets','lean_lib']),'All other Lake fields unchanged')
        return 'One library/default target; no build'
    check('Lake65_append_only',lakecheck)
    def evidence():
        f.require(sum(inv['counts'].values())==owned and inv['standard_three_guard'].startswith('PASS'),'Actual exhaustive owned inventory/std3 association')
        f.require(len(inv['foreign_generated_names'])==inv['foreign_generated_count'],'Foreign generated constants retained')
        rr={x['record_path']:x['record'] for x in raw['runs']}
        for key in ['strict','inventory','kernel','positive_controls']:f.require(rr[str(archive.record_path(c['qualification'][key]))]['exit_code']==0,'Stored '+key+' PASS')
        f.require(rr[str(archive.record_path(c['qualification']['negative']))]['exit_code']==1,'Actual sole negative rejection')
        f.require(len([x for x in raw['runs'] if 'leanchecker' in str(x['record']['command_argv'])])==1,'Exactly one owned kernel')
        f.require(raw['actual_split_stream_files']==2*raw['actual_run_count'],'All original split streams')
        helpers=raw['production_helpers'];f.require(len(helpers)==c['expected_production_helper_count']<=1,'Actual contracted helper count')
        f.require(all(x['integration_count']==1 and x['helper_executions']==0 for x in helpers),'Each production original once/zero helper executions')
        ordinary=raw['ordinary_controls_custody'];f.require(ordinary['producer_authored'] and not ordinary['text_helper_authored'],'Producer-authored ordinary Controls, no extra text helper')
        f.require(c['negative_binding']['exactly_one_intendedFalse'] and c['negative_binding']['counterproof_in_passed_controls'],'Counterproof-qualified sole mutation')
        ordinary_inv=c['ordinary_inventory_summary']
        f.require(sum(ordinary_inv['counts'].values())==ordinary_inv['all_module_index_owned_constants'] and ordinary_inv['standard_three_guard'].startswith('PASS'),'Separate complete ordinary inventory/std3 association')
        f.require(rr[str(archive.record_path(c['qualification']['ordinary_inventory']))]['exit_code']==0,'Stored ordinary inventory PASS')
        return 'Dynamic actual65 receipt schema/qualified source-controls-negative associations; no mathematical replay'
    check('retained65_evidence_and_helper_scope',evidence)
    def overlay():
        paths={str(p.relative_to(O)) for p in O.rglob('*') if p.is_file()}
        f.require(paths==set(allrecords) and len(plan['skip'])==5 and len(plan['apply'])==len(paths)-5,'Exact overlay/five installed bindings SKIP')
        f.require(not any(archive.artifact(Path(p)) for p in paths),'No actual binaries')
        f.require(not cp['copies'] and not cp['further_copy_actions'] and not plan['cache_object_actions'],'All object actions SKIP')
        return {'overlay_files':len(paths),'apply_files':len(plan['apply']),'binding_SKIP':5}
    check('exact_overlay_ALL_objects_SKIP',overlay)
    def provenance():
        f.require(c['root_reading_summary'] and c['reviewer_reading_summary'] and c['final_review_pass'],'Actual final reading scopes')
        f.require(publication['root_reading_verbatim']==reading and publication['packager_independent_review_credit']==0 and not publication['packager_is_65_proof_author'],'Honest actual reading/credit')
        f.require(publication['historical_pending_records_preserved'] and publication['same_family_credit']==0,'Historical records/process retained')
        return 'Packager65 proof-authorship FALSE/prior62A disclosed; no independent/inherited review credit; actual root/reviewer scopes distinct'
    check('honest_author_review_and_process_scopes',provenance)
    def parse():
        paths=[O/'SOURCE_MANIFEST.json',R/'APPLY_PLAN.json',R/'COPY_PLAN.json']+[O/E/n for n in ['RAW_EVIDENCE_CATALOG.json','PUBLICATION_CONTEXT.json','COPY_PLAN.json',CNAME]]
        for path in paths:f.read(path)
        return {'new_metadata_JSONs':len(paths),'old_raw_JSON_rechecks':0}
    check('new_metadata_JSON_parse',parse)
    counts={'modules':65,'written':1135,'Prop':1126,'data':9,'inputs':32,'manifest_entries':len(manifest['files']),'new_manifest_entries':len(newpaths),'overlay_files':len(allrecords),'apply_files':len(plan['apply']),'binding_SKIP':5,'actual_owned_constants':owned,'actual_runs':raw['actual_run_count'],'verification_runs':raw['verification_run_count'],'documentary_runs':raw['documentary_run_count'],'unlabeled_runs':raw['unlabeled_run_count'],'split_stream_files':raw['actual_split_stream_files'],'split_stream_bytes':raw['actual_split_stream_bytes'],'excluded_artifacts':len(raw['excluded_artifacts'])}
    result={'status':'NEW65_METADATA_ASSEMBLY_AND_BOUNDED_ASSOCIATIONS_PASS','source_cut':cut,'qualified_baseline':f.BASE,'counts':counts,'owned_constants':owned,'manifest_identity':mid,'sums_identity':sid,'catalog_identity':records[E+'/'+CNAME],'apply_plan_identity':pid,'object_action':'SKIP_ROOT_COPIED_ONCE','old_payload_hashes':0,'proof_replays':0}
    f.write(R/'ASSEMBLY_RESULT.json',result);print(json.dumps(result,sort_keys=True),flush=True)
if __name__=='__main__':assemble()
