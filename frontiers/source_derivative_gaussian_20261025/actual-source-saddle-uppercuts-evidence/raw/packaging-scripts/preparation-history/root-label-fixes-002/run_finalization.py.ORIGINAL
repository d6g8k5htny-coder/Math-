#!/usr/bin/env python3
"""One future65 worker and custody seal; no mathematical execution."""
import json,subprocess,sys,time
import custody as f
import archive_prepare
R=f.R;A=R/'metadata-attempts/attempt-001'
archive_prepare.gate(f.read(R/'FINAL_INPUTS.json'))
if A.exists():raise RuntimeError('Prior actual metadata attempt preserved; no automatic restart/replay')
A.mkdir(parents=True);f.syncdirs(A)
cmd=[sys.executable,str(R/'finalize_metadata.py')];start=f.now();tick=time.monotonic()
f.put(A/'started.json',{'attempt':1,'command':cmd,'cwd':'/workspace','started_utc':start,'scope':'New65 archive/metadata association after actual final root GO; original separate streams'})
for name in ['custody.py','archive_prepare.py','finalize_metadata.py','run_finalization.py','launch_finalization.py','entry_finalization.py']:
    f.durable(A/name,(R/name).read_bytes());f.identity(A/name)
with (A/'stdout.log').open('wb') as out,(A/'stderr.log').open('wb') as err:
    proc=subprocess.run(cmd,cwd='/workspace',stdout=out,stderr=err)
    out.flush();f.os.fsync(out.fileno());err.flush();f.os.fsync(err.fileno())
f.syncdirs(A)
receipt={'attempt':1,'command':cmd,'cwd':'/workspace','started_utc':start,'ended_utc':f.now(),'elapsed_seconds':time.monotonic()-tick,'exit_code':proc.returncode,'stdout':'stdout.log','stderr':'stderr.log','full_actual_capture':True,'old_hashes':0,'proof_replays':0}
f.put(A/'execution_receipt.json',receipt)
captures={name:f.identity(A/name) for name in ['started.json','stdout.log','stderr.log','execution_receipt.json']}
if proc.returncode:
    f.write(R/'FAILED_METADATA_ATTEMPT.json',{'status':'ACTUAL_FAILURE_PRESERVED_SCOPED_CONTINUATION_ONLY','receipt':receipt,'captures':captures,'reuse_completed_checks_and_identities':'VALIDATION_PROGRESS.jsonl/IDENTITY_JOURNAL.jsonl/ARCHIVE_PROGRESS.jsonl; invalidate only concretely affected scope'})
    print((A/'stderr.log').read_text());sys.exit(proc.returncode)
result=f.read(R/'ASSEMBLY_RESULT.json')
checks=[json.loads(line) for line in (R/'VALIDATION_PROGRESS.jsonl').read_text().splitlines() if json.loads(line)['event']=='check_passed']
validation={**receipt,'status':'PASS','checks_passed':len(checks),'completed_checks':checks,'capture_identities':captures,'scope':'New65 metadata associations only; no Lean/proof/kernel/control/old-hash replay'}
vid=f.write(R/'METADATA_VALIDATION_RECEIPT.json',validation)
report="""# Stage65 exact scratch proposal ready

Exactly ONE actual uniform CLOSED saddle-uppercut proposition/no public data appends to qualified64:65 modules/1135 written=1126Prop+9data/32. ONE actual public64 witness is internally consumed exactly once; SAME chart/radius/source/field/exact Pi target serves inherited ALL delta>=0 lower traces and ALL0<epsilon<rho^2/4 CLOSED upper sign branches/union/JoinedIn. No global hm/per-cut chart/certificate/norm-isometry premise.

Actual finite sample, both saddles/seam/small O and equality-at-cutoff are retained. ONE complete private geometry TEXT original once-integrated/zero helper execution/hash/object; producer owns all ordinary Controls and amendments. Production and ordinary exhaustive inventories/std3 are distinct; EXACTLY ONE final production kernel covers no ordinary Controls. Sole mutation epsilon>0 to epsilon>=0 fixes SAME actual chart/source/radius/field/carrier/CLOSED cut; independent inverse vertical zero-cut path with actual midpoint q refutes JoinedIn/sign product before ONE importing False. No production-upper/lower-PC shortcut.

One metadata cycle passes seven bounded associations. All sizes/counts/IDs/source-harness-runner-context versions/snapshots/FULL patches/ACKs/commands/cwd/times/exits/original streams and actual capture limits derive from frozen inputs. This metadata worker, outer orchestration and entry have prospective original separate captures; entry closes after the immutable handoff, without archive resealing. Cached first-new identities only; no unchanged payload hash/math/control/kernel/CI/object replay. Historical capture limitations remain separate and never fabricated.

Inherited7331 manifest KEY prefix and independent checksum ROW prefix preserved separately. Only README/SCOPE/lakefile old digests change. Source/four final citation-corrected PRECODE65 bindings and new evidence appended without self entries. Five installed bindings/ALL object actions SKIP after root's ONLY eligible final own copy. Root alone applies/Git/cache/native publication; no CLI auth retry/change or packager external action. All future66 proper root EXTRA docs excluded.

Packager65 proof-author FALSE/prior62A exposure disclosed; independentcredit0/scienceNONE/samefamily0. Root and nonauthor technical reading scopes remain separately attributed. Existing64 CI is not65 CI; no future claim/seat or broader research-goal completion. Completed applicable verification reusable; provider-distinct process separate.
"""
f.durable(R/'REPORT.md',report.encode());rid=f.identity(R/'REPORT.md')
cid=f.write(R/'CUSTODY_IDENTITIES.json',{'status':'FROZEN64_IDENTITIES','files':list(f.identities().values()),'journal':'IDENTITY_JOURNAL.jsonl','self_and_final_handoff':'Recorded after snapshot; no recursive self identity claim'})
c=f.read(R/'FINAL_INPUTS.json')
handoff={'status':'FINAL_READY_FROZEN_ROOT_ONLY_APPLY_NOT_APPLIED','source_cut':result['source_cut'],'qualified_baseline':result['qualified_baseline'],'overlay_root':str(R/'overlay'),'apply_plan':f.identities()[str(R/'APPLY_PLAN.json')],'copy_plan':f.identities()[str(R/'COPY_PLAN.json')],'counts':result['counts'],'manifest_identity':result['manifest_identity'],'sums_identity':result['sums_identity'],'catalog_identity':result['catalog_identity'],'metadata_receipt_identity':vid,'report_identity':rid,'custody_snapshot_identity':cid,'actual_metadata_executions':1,'failed_metadata_executions':0,'metadata_checks_passed':len(checks),'actual_worker_capture':receipt,'capture_identities':captures,'entry_capture':'entry-captures/metadata-attempt-001/{started.json,stdout.log,stderr.log,receipt.json}; actual prospective entry capture closes after handoff, no recursive seal or premature completion claim','outer_launcher_capture':'launcher-captures/metadata-attempt-001/{started.json,stdout.log,stderr.log,receipt.json}; full original wrapper+seal streams, no selfhash claimed','identity_journal':'IDENTITY_JOURNAL.jsonl','copy_journal':'ARCHIVE_PROGRESS.jsonl','check_journal':'VALIDATION_PROGRESS.jsonl','own_object_action':'SKIP_ROOT_COPIED_ONCE_ALL_FURTHER_COPIES_SKIP','actual_owned_constants':result['owned_constants'],'owned_foreign_generated':c['inventory_summary']['foreign_generated_count'],'production_helpers_once':len(c['production_helper_integrations']),'Controls_only_helper_once':0,'packager_is_65_proof_author':False,'packager_proof_role':'65 metadata only; prior62A does not transfer proof authorship','independent_scientific_review_credit':0,'old_payload_hashes':0,'proof_replays':0,'shared_mutations':0,'scientific_effect':'NONE','same_family_credit':0,'canonical_authority':f.AUTHORITY}
f.write(R/'FINAL_HANDOFF.json',handoff);print(json.dumps({'status':handoff['status'],'counts':result['counts']},sort_keys=True),flush=True)
