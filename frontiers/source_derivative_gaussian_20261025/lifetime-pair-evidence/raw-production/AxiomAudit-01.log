theorem I4SourceLifetimePairFiniteness.actual_critical_coordinateGradient_zero : ∀ {L : ℝ},
  0 < L →
    ∀ (ω : I4SmoothCarrier.SmoothSample 2 L) (x : UniversalLaw.Spec.Lifetime.E 2),
      UniversalLaw.Spec.Lifetime.IsCriticalPoint 2 (I4LifetimeField.actualField 2 L ω) x →
        I4ActualSourceMorse.coordinateGradient (I4SmoothCarrier.smoothSourceField 2 L ω)
            ((I4LifetimeField.coordinates 2) x) =
          0 :=
fun {L} hL ω x hx =>
  have hdiff :=
    DifferentiableAt.hasFDerivAt
      (ContDiff.differentiable (I4SmoothCarrier.smoothSourceField_contDiff 2 (LT.lt.ne' hL) ω 1)
        (of_eq_true
          (Eq.trans (congrFun' (congrArg Ne Nat.cast_one) 0)
            (Eq.trans (congrArg Not one_ne_zero._simp_1) not_false_eq_true)))
        ((I4LifetimeField.coordinates 2) x));
  have hcomp := HasFDerivAt.comp x hdiff (ContinuousLinearEquiv.hasFDerivAt (I4LifetimeField.coordinates 2));
  id
    (fun hx =>
      have hz := Eq.trans (Eq.symm (HasFDerivAt.fderiv hcomp)) hx;
      funext fun i =>
        have hzi := congrArg (fun D => D ((I4LifetimeField.coordinates 2).symm (Pi.single i 1))) hz;
        id
          (Eq.mp
            (congr
              (congrArg Eq
                (congrArg (⇑(fderiv ℝ (I4SmoothCarrier.smoothSourceField 2 L ω) ((I4LifetimeField.coordinates 2) x)))
                  (ContinuousLinearEquiv.apply_symm_apply (I4LifetimeField.coordinates 2) (Pi.single i 1))))
              (zero_apply ((I4LifetimeField.coordinates 2).symm (Pi.single i 1))))
            hzi))
    hx
theorem I4SourceLifetimePairFiniteness.coordinates_fundDomain_mem_sourceMorseCube : ∀ {L : ℝ},
  0 < L →
    ∀ {x : UniversalLaw.Spec.Lifetime.E 2},
      x ∈ UniversalLaw.Spec.Lifetime.FundDomain 2 L →
        (I4LifetimeField.coordinates 2) x ∈ I4ActualSourceMorse.sourceMorseCube L :=
fun {L} hL {x} hx =>
  ⟨fun i => (hx i).left, fun i =>
    id (Eq.mpr (id (congrArg (fun _a => x.ofLp i ≤ _a) (abs_of_pos hL))) (LT.lt.le (hx i).right))⟩
theorem I4SourceLifetimePairFiniteness.smoothLaw_ae_finite_criticalFundDomain : ∀ {L : ℝ},
  0 < L →
    ∀ᵐ (ω : I4SmoothCarrier.SmoothSample 2 L) ∂I4SmoothCarrier.smoothLaw 2 L,
      {x |
          x ∈ UniversalLaw.Spec.Lifetime.FundDomain 2 L ∧
            UniversalLaw.Spec.Lifetime.IsCriticalPoint 2 (I4LifetimeField.actualField 2 L ω) x}.Finite :=
fun {L} hL =>
  Filter.mp_mem (I4ActualSourceMorse.smoothLaw_ae_finite_sourceCriticalCube (LT.lt.ne' hL))
    (Filter.univ_mem'
      (id fun ω hω =>
        Set.Finite.subset
          (Set.Finite.preimage
            (Function.Injective.injOn (ContinuousLinearEquiv.injective (I4LifetimeField.coordinates 2))) hω)
          fun ⦃x⦄ a =>
          And.casesOn a fun hx hcrit =>
            ⟨I4SourceLifetimePairFiniteness.coordinates_fundDomain_mem_sourceMorseCube hL hx,
              I4SourceLifetimePairFiniteness.actual_critical_coordinateGradient_zero hL ω x hcrit⟩))
theorem I4SourceLifetimePairFiniteness.smoothLaw_ae_finite_pairSet_of_critical : ∀ {L : ℝ},
  0 < L →
    ∀ᵐ (ω : I4SmoothCarrier.SmoothSample 2 L) ∂I4SmoothCarrier.smoothLaw 2 L,
      ∀
        (Pair :
          (UniversalLaw.Spec.Lifetime.E 2 → ℝ) →
            UniversalLaw.Spec.Lifetime.E 2 → UniversalLaw.Spec.Lifetime.E 2 → Prop),
        (∀ (M S : UniversalLaw.Spec.Lifetime.E 2),
            Pair (I4LifetimeField.actualField 2 L ω) M S →
              UniversalLaw.Spec.Lifetime.IsCriticalPoint 2 (I4LifetimeField.actualField 2 L ω) M ∧
                UniversalLaw.Spec.Lifetime.IsCriticalPoint 2 (I4LifetimeField.actualField 2 L ω) S) →
          ∀ (A : Set ℝ), (UniversalLaw.Spec.Lifetime.pairSet 2 L Pair (I4LifetimeField.actualField 2 L ω) A).Finite :=
fun {L} hL =>
  Filter.mp_mem (I4SourceLifetimePairFiniteness.smoothLaw_ae_finite_criticalFundDomain hL)
    (Filter.univ_mem'
      (id fun ω hω Pair hPair A =>
        Set.Finite.subset (Set.Finite.prod hω hω) fun ⦃a⦄ =>
          Prod.casesOn (motive := fun x =>
            x ∈ UniversalLaw.Spec.Lifetime.pairSet 2 L Pair (I4LifetimeField.actualField 2 L ω) A →
              x ∈
                {x |
                    x ∈ UniversalLaw.Spec.Lifetime.FundDomain 2 L ∧
                      UniversalLaw.Spec.Lifetime.IsCriticalPoint 2 (I4LifetimeField.actualField 2 L ω) x} ×ˢ
                  {x |
                    x ∈ UniversalLaw.Spec.Lifetime.FundDomain 2 L ∧
                      UniversalLaw.Spec.Lifetime.IsCriticalPoint 2 (I4LifetimeField.actualField 2 L ω) x})
            a fun M S a =>
            And.casesOn a fun hM right =>
              And.casesOn right fun hS right =>
                And.casesOn right fun hpair right => ⟨⟨hM, (hPair M S hpair).left⟩, ⟨hS, (hPair M S hpair).right⟩⟩))
theorem I4SourceLifetimePairFiniteness.smoothLaw_ae_finite_candidatePairSet : ∀ {L : ℝ},
  0 < L →
