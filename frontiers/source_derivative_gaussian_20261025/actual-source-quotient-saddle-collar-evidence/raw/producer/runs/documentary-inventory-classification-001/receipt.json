    "from pathlib import Path\nimport re,json,collections\nb=Path(\"/workspace/scratch/actual-source-quotient-saddle-collar-construct\")\nraw=(b/\"runs/inventory-001/stdout.log\").read_text();rows=[]\nprivate=\"_private.SourceActualQuotientSaddleCollar.0.I4SourceActualQuotientSaddleCollar.\"\npublic=\"I4SourceActualQuotientSaddleCollar.\"\nfor m in re.finditer(r\"INVENTORY\\|([^|\\n]+)\\|([^\\n]+)\\nAXIOMS\\|[^|\\n]+\\|\\[([^\\]]*)\\]\",raw,re.S):\n    kind,name,axs=m.groups();short=name.removeprefix(private).removeprefix(public)\n    if not name.startswith(private) and not name.startswith(public): c=\"foreign-namespace generated declaration\"\n    elif short in [\"ChartFacts\",\"SaddleGeometry\",\"CollarFacts\"]:c=\"authored private Prop bundle\"\n    elif short==\"Point2\":c=\"authored private type alias\"\n    elif short.startswith(\"ChartFacts.\") or short.startswith(\"SaddleGeometry.\"):\n        if kind==\"constructor\":c=\"generated private Prop-bundle constructor\"\n        elif kind==\"recursor\":c=\"generated private Prop-bundle recursor\"\n        elif kind==\"theorem\":c=\"generated private Prop-bundle projection\"\n        else:c=\"generated private Prop-bundle eliminator or auxiliary\"\n    elif \"._proof_\" in short:c=\"private generated proof auxiliary\"\n    elif \"._simp_\" in short:c=\"private generated simp theorem\"\n    elif \".eq_\" in short or short.endswith(\".eq_def\"):c=\"private generated defining equation\"\n    elif short==\"actualSource_quotient_saddle_local_collar\":c=\"sole authored public theorem\"\n    elif short in [\"targetStrict\",\"targetPlus\",\"targetMinus\",\"targetLower\"]:c=\"authored private finite-geometry set definition\"\n    elif kind==\"definition\":c=\"authored private definition\"\n    elif kind==\"theorem\":c=\"authored private theorem\"\n    else:c=\"other owned generated declaration\"\n    rows.append({\"kind\":kind,\"name\":name,\"axioms\":[a.strip() for a in axs.split(\",\") if a.strip()],\"classification\":c})\nexpected=int(re.search(r\"COMPLETE_NEW_MODULE_INVENTORY\\|SourceActualQuotientSaddleCollar\\|(\\d+)\",raw).group(1))\nassert len(rows)==expected\ncounts=dict(collections.Counter(r[\"classification\"] for r in rows))\nd={\"module\":\"SourceActualQuotientSaddleCollar\",\"total\":expected,\"counts\":counts,\"allowed_axioms\":[\"propext\",\"Classical.choice\",\"Quot.sound\"],\"declarations\":rows,\"coverage\":\"ALL exact own-module-index constants, NO namespace prefilter. Authored/private/data/Prop bundles/generated constructors/projections/recursors/auxiliaries/foreign namespace explicitly classified.\",\"zero_count_categories\":[c for c in [\"foreign-namespace generated declaration\",\"other owned generated declaration\"] if c not in counts],\"receipt\":str(b/\"runs/inventory-001/receipt.json\"),\"harness_provenance\":\"Generic accepted module-index infrastructure, only NEW module imported; no old module execution or private proof dependency.\"}\n(b/\"INVENTORY.json\").write_text(json.dumps(d,indent=2)+\"\\n\")\nfor r in rows:print(r[\"kind\"],\"|\",r[\"classification\"],\"|\",r[\"name\"].removeprefix(private).removeprefix(public),\"|\",\",\".join(r[\"axioms\"]))\nprint(json.dumps({\"total\":expected,\"counts\":counts,\"zero_categories\":d[\"zero_count_categories\"]},indent=2))\n"
  ],
