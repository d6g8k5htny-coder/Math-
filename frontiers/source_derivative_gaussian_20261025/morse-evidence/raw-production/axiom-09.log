theorem I4ActualSourceMorse.smoothLaw_ae_sourceMorseCube : ∀ {L : ℝ},
  L ≠ 0 →
    ∀ᵐ (ω : I4SmoothCarrier.SmoothSample 2 L) ∂I4SmoothCarrier.smoothLaw 2 L,
      ∀ x ∈ I4ActualSourceMorse.sourceMorseCube L, 0 < I4ActualSourceMorse.sourceMorseDiscriminant L ω x :=
fun {L} hL =>
  I4ActualSourceMorse.actual_finite_replacement_ae 2 hL I4ActualSourceMorse.fourModeSet
    {ω | ∀ x ∈ I4ActualSourceMorse.sourceMorseCube L, 0 < I4ActualSourceMorse.sourceMorseDiscriminant L ω x}
    (I4ActualSourceMorse.sourceMorseCube_event_measurable hL) fun ρ =>
    I4ActualSourceMorse.actual_four_replacement_bad_null hL ρ (I4ActualSourceMorse.sourceMorseCube L)
theorem I4ActualSourceMorse.smoothLaw_ae_sourceMorse : ∀ {L : ℝ},
  L ≠ 0 →
    ∀ᵐ (ω : I4SmoothCarrier.SmoothSample 2 L) ∂I4SmoothCarrier.smoothLaw 2 L,
      ∀ (x : Fin 2 → ℝ), 0 < I4ActualSourceMorse.sourceMorseDiscriminant L ω x :=
fun {L} hL =>
  have hballs := fun n =>
    I4ActualSourceMorse.smoothLaw_ae_sourceMorseCompact hL (Metric.closedBall 0 ↑n) (isCompact_closedBall 0 ↑n);
  Filter.mp_mem (MeasureTheory.ae_all_iff.mpr hballs)
    (Filter.univ_mem'
      (id fun ω hω x =>
        Exists.casesOn (exists_nat_gt ‖x‖) fun n hn =>
          hω n x
            (Eq.mpr
              (id
                (Eq.trans I4ActualSourceMorse.smoothLaw_ae_sourceMorse._simp_1_1
                  (congrFun' (congrArg LE.le (dist_zero_right x)) ↑n)))
              (LT.lt.le hn))))
theorem I4ActualSourceMorse.smoothLaw_ae_finite_sourceCriticalCube : ∀ {L : ℝ},
  L ≠ 0 →
    ∀ᵐ (ω : I4SmoothCarrier.SmoothSample 2 L) ∂I4SmoothCarrier.smoothLaw 2 L,
      {x |
          x ∈ I4ActualSourceMorse.sourceMorseCube L ∧
            I4ActualSourceMorse.coordinateGradient (I4SmoothCarrier.smoothSourceField 2 L ω) x = 0}.Finite :=
fun {L} hL =>
  Filter.mp_mem (I4ActualSourceMorse.smoothLaw_ae_sourceMorseCube hL)
    (Filter.univ_mem'
      (id fun ω hω =>
        I4ActualSourceMorse.finite_regular_zeros_on_compact
          (I4ActualSourceMorse.coordinateGradient (I4SmoothCarrier.smoothSourceField 2 L ω))
          (I4ActualSourceMorse.coordinateGradient_contDiff (I4SmoothCarrier.smoothSourceField 2 L ω)
            (I4SmoothCarrier.smoothSourceField_smooth 2 hL ω))
          (I4ActualSourceMorse.sourceMorseCube L) (I4ActualSourceMorse.sourceMorseCube_isCompact L) fun x hx hcrit =>
          I4ActualSourceMorse.sourceMorse_regular hL ω x (hω x hx) hcrit))
