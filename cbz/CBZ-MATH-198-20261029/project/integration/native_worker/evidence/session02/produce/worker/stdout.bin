{"goals":["∀ (cap : ℕ),\n  1 ≤ cap →\n    UniversalLaw.Spec.P15.IsRealizedFamily (UniversalLaw.Spec.P15.demandOneBlock cap) ∧\n      (∀ (U : Finset (Fin (cap + 1))),\n          U ∈ UniversalLaw.Spec.P15.obstruction (UniversalLaw.Spec.P15.demandOneBlock cap) 1 ↔ U = Finset.univ) ∧\n        (1 ≤ UniversalLaw.Spec.P15.coverCost (UniversalLaw.Spec.P15.demandOneBlock cap) 1 fun x => 1) ∧\n          (UniversalLaw.Spec.P15.mu (UniversalLaw.Spec.P15.demandOneBlock cap) fun x => UniversalLaw.Spec.P15.pStar) =\n              1 - UniversalLaw.Spec.P15.pStar ^ (cap + 1) ∧\n            Real.exp (-1) < 1 - UniversalLaw.Spec.P15.pStar ^ (cap + 1) ∧\n              -Real.log\n                      (UniversalLaw.Spec.P15.mu (UniversalLaw.Spec.P15.demandOneBlock cap) fun x =>\n                        UniversalLaw.Spec.P15.pStar) <\n                  1 ∧\n                ∀ ρ ≤ 1,\n                  UniversalLaw.Spec.P15.cappedHazard ρ\n                      (UniversalLaw.Spec.P15.mu (UniversalLaw.Spec.P15.demandOneBlock cap) fun x =>\n                        UniversalLaw.Spec.P15.pStar) <\n                    UniversalLaw.Spec.P15.coverCost (UniversalLaw.Spec.P15.demandOneBlock cap) 1 fun x => 1"],"id":189,"ok":true,"protocol":"ul-closed-proof-v1","session":"cf0653d97db44b30903abd8a2f766efc","state":47,"status":"opened","task":"p15.DemandOneBoundary"}
